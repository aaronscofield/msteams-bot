# Auth for the Azure Bot (SingleTenant). Client/tenant ids are the bot's Entra app registration.
# Python SDK keys are UPPERCASE: CONNECTIONS__<name>__SETTINGS__<KEY>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=certificate
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<entra-app-client-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<entra-tenant-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CERTPFXFILE=./certs/bot.pfx
# Client-secret alternative: AUTHTYPE=ClientSecret and
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<secret>

# Reject inbound tokens whose issuer is not Bot Framework or this tenant (SDK default is advisory only)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__VALIDATE_ISSUER=true

# Route every service URL to the connection above
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

PORT=3978

# Optional: POST every approval decision here
# APPROVAL_WEBHOOK_URL=https://example.com/hook
# Teams Bot Connector region (app.py logs the real one on each incoming activity)
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/amer/

# Org-catalog ID of the bot app: Teams admin center → Manage apps → Company Approval Bot → "App ID" (NOT "External app ID").
# Required with the Self permission: Graph only matches installs by teamsApp/id, and it avoids needing AppCatalog.Read.All.
# TEAMS_CATALOG_APP_ID=

# Internal API (POST …/approvals on the bot). Optional: set APPROVALS_API_KEY to require Authorization: Bearer <key>
# APPROVALS_API_KEY=
BOT_URL=http://localhost:3978

# Container: set HOST=0.0.0.0 (Dockerfile does) and pass the cert as base64 instead of a file path:
# CERT_PFX_BASE64=$(base64 -i certs/bot.pfx)

# --- click verification ---------------------------------------------------------------------
# Entra group whose (transitive) members may approve. Needs GroupMember.Read.All (application) on the bot app.
# APPROVERS_GROUP_ID=
# Pending requests expire after this many hours (default 168 = 7 days)
# APPROVAL_TTL_HOURS=168
# Teams SSO (see README → Teams SSO for the one-time Entra / Azure Bot setup). A configured handler turns it on.
# AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__TYPE=UserAuthorization
# AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=teams-sso

# Serve Swagger UI (/docs), ReDoc (/redoc) and /openapi.json. Off by default; `make dev` turns it on.
# ENABLE_DOCS=false

# Route prefix /<domain>/<subdomain>/<version> — defaults shown
# API_DOMAIN=company
# API_SUBDOMAIN=bot
# API_VERSION=v1

